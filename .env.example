# ── SAFE Calculator backend — environment template ─────────────────────────
# Copy to .env for local dev. In production set these in the Render dashboard
# (Service → Environment). Do NOT commit a real .env.

# Render injects PORT automatically; this is only for local dev.
PORT=3005

# Mark the runtime as production so the CORS-open safety warning fires.
NODE_ENV=production

# CORS allowlist (comma-separated, bare origins, NO trailing slash / path).
# Must list every origin the embedded calculator is served from — i.e. your
# published Webflow domain(s).
# Example:
# ALLOWED_ORIGINS=https://your-site.webflow.io,https://www.yourdomain.com
ALLOWED_ORIGINS=

# Max concurrent PDF renders (memory protection). Default 3.
MAX_CONCURRENT_PDFS=3

# Optional explicit Chrome path. Leave unset to use @sparticuz/chromium in the
# container. Set only if you bundle a specific browser.
# CHROME_PATH=
